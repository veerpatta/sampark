# Sampark — environment variables
# Copy to .env.local for development. NEVER prefix any of these with NEXT_PUBLIC_.
# The browser must never hold a database credential; every read and write goes
# through a Next.js server route. See SAMPARK_BUILD_PLAN.md section 3.

# --- Database (Neon, ap-south-1 / Mumbai) ---
# Pooled connection string, app_rw role. Used by the application at runtime.
DATABASE_URL=
# Direct (unpooled) connection, owner role. Used by drizzle-kit for migrations only.
DATABASE_URL_UNPOOLED=

# --- Admin auth (Auth.js v5, Credentials provider) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- App ---
APP_TIMEZONE=Asia/Kolkata
ACADEMIC_YEAR=2026-27

# --- Rate limiting (optional; falls back to in-memory in development) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
