# Sampark — environment variables
# Copy to .env.local for development. NEVER prefix any of these with NEXT_PUBLIC_.
# The browser must never hold a database credential; every read and write goes
# through a Next.js server route. See SAMPARK_BUILD_PLAN.md section 3.

# --- Database (Neon, ap-south-1 / Mumbai) ---
# Pooled connection string, app_rw role. Used by the application at runtime.
DATABASE_URL=
# Direct (unpooled) connection, owner role. Used by drizzle-kit for migrations only.
DATABASE_URL_UNPOOLED=

# --- Admin auth (Auth.js v5, Credentials provider) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- App ---
APP_TIMEZONE=Asia/Kolkata
ACADEMIC_YEAR=2026-27

# --- Student photos (Vercel Blob, private store) ---
# Create the store in the Vercel dashboard and paste its read-write token here.
# Photographs of children are stored with access: 'private', so they have no
# public URL at all — every read goes through /api/photos (admin session) or
# /api/r/<token>/photo (the teacher's own roster). Without this variable a photo
# round cannot be run; nothing else in the app needs it.
BLOB_READ_WRITE_TOKEN=

# --- Rate limiting (optional; falls back to in-memory in development) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Test fixtures (development only; never set this in production) ---
# `npm run db:seed:test` builds a small fake school — invented children, invented
# teachers, and one owner account — for driving the console by hand. It REFUSES
# to run against a database holding anyone who is not a fixture, so it cannot
# touch the real school.
#
# The account's email is in the repo, so its password is not: set one here and
# re-run the seed to be able to sign in by hand. Leave it blank and the account
# still exists but cannot be logged into, which is the right default.
# `npm run smoke:ui` never needs it — it mints its own session (scripts/test-session.ts).
TEST_LOGIN_PASSWORD=
