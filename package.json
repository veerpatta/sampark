{
  "name": "sampark",
  "version": "0.1.0",
  "private": true,
  "description": "Sampark — VPPS Data Desk. Collect and reconcile student data from mobile-only teachers.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:grants": "tsx scripts/db-grants.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx drizzle/seed/index.ts",
    "db:seed:branch": "tsx scripts/seed-branch.ts",
    "db:seed:test": "tsx scripts/seed-test-school.ts",
    "db:create-user": "tsx scripts/create-user.ts",
    "subjects:import": "tsx scripts/import-timetable-subjects.ts",
    "icons": "tsx scripts/make-icons.ts",
    "photos:verify": "tsx scripts/verify-photos.ts",
    "db:migrate:branch": "tsx scripts/migrate-branch.ts",
