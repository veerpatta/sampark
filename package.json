    "smoke:ui": "tsx scripts/smoke-ui.ts",
    "test:session": "tsx scripts/test-session.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "next": "16.4.5",
    "next-auth": "^5.0.0-beta.29",
    "papaparse": "^5.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
